# Steel Poleaxe → Strength II + Slowness I
/effect give @a[scores={poleaxe=1}] strength 2 1 true
/effect give @a[scores={poleaxe=1}] slowness 2 0 true

# Wind Poleaxe → Strength I + Speed II + Jump Boost I
/effect give @a[scores={poleaxe=2}] strength 2 0 true
/effect give @a[scores={poleaxe=2}] speed 2 1 true
/effect give @a[scores={poleaxe=2}] jump_boost 2 0 true

# Netherite Poleaxe → Strength III + Resistance I + Slowness III
/effect give @a[scores={poleaxe=3}] strength 2 2 true
/effect give @a[scores={poleaxe=3}] resistance 2 0 true
/effect give @a[scores={poleaxe=3}] slowness 2 2 true
